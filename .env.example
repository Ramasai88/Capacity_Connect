# PostgreSQL connection string
# Example for local Docker/Postgres: postgresql://postgres:postgres@localhost:5432/capacity_connect
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/capacity_connect"

# Auth.js (NextAuth) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Application Base URL (used for activation emails & deep links)
# Local: http://localhost:3000 | Production: https://your-app.onrender.com
APP_BASE_URL="http://localhost:3000"

# Production Email Delivery (Brevo HTTPS API — required when NODE_ENV=production)
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_FROM_EMAIL="service.capacityconnect@gmail.com"
BREVO_FROM_NAME="Capacity Connect"

# Development Email Delivery (Gmail / Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-development-email@gmail.com"
SMTP_PASSWORD="your-development-app-password"
SMTP_FROM='"Capacity Connect" <no-reply@capacityconnect.internal>'

