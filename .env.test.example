# Capacity Connect — Test Environment Configuration
# Automated tests and test database commands strictly read this configuration.

# Dedicated Test Database URL (MUST NOT be the production database)
# Option 1: Local PostgreSQL (Recommended)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/capacity_connect_test"

# Option 2: Dedicated Remote / Docker PostgreSQL Test Database
# DATABASE_URL="postgresql://test_user:test_password@localhost:5432/capacity_connect_test"

# Environment & Application Settings for Testing
NODE_ENV="test"
APP_BASE_URL="http://localhost:3000"
NEXTAUTH_SECRET="test-secret-at-least-32-characters-long-key"
NEXTAUTH_URL="http://localhost:3000"
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
